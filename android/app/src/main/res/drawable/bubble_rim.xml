<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent white border rendered OVER the avatar image to give the
     bubble a polished "glass ring" look without overdraw on the avatar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke
        android:width="2dp"
        android:color="#50FFFFFF" />
    <solid android:color="@android:color/transparent" />
</shape>