{
  "name": "functions",
  "description": "Cloud Functions for Firebase — App Chat Plus AI Backend",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:prod": "firebase deploy --only functions --project production",
    "logs": "firebase functions:log",
    "logs:tail": "firebase functions:log --only analyzeScam,suggestReplies,generateWeeklyRecap"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^1.5.0",
    "agora-access-token": "^2.0.4",
    "cors": "^2.8.6",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.28.0",
    "firebase-functions-test": "^3.4.0",
    "globals": "^17.6.0"
  },
  "private": true
}
